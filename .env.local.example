# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional — if you create a recurring Stripe Price for each product, paste its
# ID here. If unset, the checkout API falls back to one-off price_data using the
# priceCents value from lib/products.ts.
STRIPE_PRICE_THE_PACIFIC_PLATE=

# Beehiiv (optional — subscribe API soft-fails if these are missing)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend (optional — for transactional purchase emails)
RESEND_API_KEY=
