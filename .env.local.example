# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin — the email allowed to access /admin. Sign in there with a
# Supabase magic link; only this address sees the dashboard.
ADMIN_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional — if you create a recurring Stripe Price for each product, paste its
# ID here. If unset, the checkout API falls back to one-off price_data using the
# priceCents value from lib/products.ts.
STRIPE_PRICE_THE_PACIFIC_PLATE=

# Beehiiv (optional — subscribe API soft-fails if these are missing)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# Optional — the welcome automation's ID (format aut_...). When set, new
# subscribers are enrolled into it via `automation_ids` on signup. The
# automation must have an "Add by API" trigger enabled in Beehiiv, or the
# welcome sequence won't fire for API-created subscribers.
BEEHIIV_AUTOMATION_ID=

# Resend (optional — for transactional purchase emails)
RESEND_API_KEY=
